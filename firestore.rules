rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMaster() {
      return signedIn() && request.auth.uid == 'KZhENlWEtPNO5w2t6pgh8NTE0wW2';
    }
    function restauranteRef(restauranteId) {
      return /databases/$(database)/documents/restaurantes/$(restauranteId);
    }
    function isDono(restauranteId) {
      return signedIn()
        && exists(restauranteRef(restauranteId))
        && get(restauranteRef(restauranteId)).data.ownerUid == request.auth.uid;
    }

    // Vínculo de usuário é escrito exclusivamente pelo Mestre.
    match /usuarios/{uid} {
      allow get: if isMaster() || (signedIn() && request.auth.uid == uid);
      allow list: if isMaster();
      allow create, update, delete: if isMaster();
    }

    match /restaurantes/{restauranteId} {
      allow read: if isMaster() || isDono(restauranteId);
      allow create, update, delete: if isMaster();
      match /configuracoes/{configId} {
        allow read, write: if isMaster() || isDono(restauranteId);
      }
      match /categorias/{categoriaId} {
        allow read, write: if isMaster() || isDono(restauranteId);
      }
      match /produtos/{produtoId} {
        allow read, write: if isMaster() || isDono(restauranteId);
      }
    }

    // As coleções globais antigas ficam negadas nesta arquitetura multi-restaurante.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
