rules_version = '2';

// Deu Fome — regras do Firestore (pedidos com acompanhamento público e avisos push)
// Publicar: `firebase deploy --only firestore:rules` (veja firebase.json) ou colar em
// Firebase Console > Firestore Database > Regras > Publicar. Sempre que o código mudar, publique junto.
//
// Modelo:
//   restaurantes/{id}                      dados e configurações (leitura pública só se ativo)
//   restaurantes/{id}/membros/{uid}        quem pode gerenciar (criado só pelo Mestre)
//   restaurantes/{id}/categorias/{id}      categorias do cardápio (leitura pública só se ativas)
//   restaurantes/{id}/produtos/{id}        produtos (preço em centavos; nunca apagados, só arquivados)
//   restaurantes/{id}/ingredientes/{id}    ingredientes e preço de compra (PRIVADO: só o restaurante)
//   restaurantes/{id}/receitas/{produtoId} receita e custo do produto (PRIVADO: só o restaurante)
//   restaurantes/{id}/cupons/{CODIGO}      cupons de desconto (PRIVADO: o cliente confere pela API; "usos" só o servidor muda)
//   restaurantes/{id}/pedidos/{id}         pedido COMPLETO (nome, telefone, endereço): só o restaurante lê;
//                                          CRIADO SÓ PELO SERVIDOR (/api/criar-pedido)
//   restaurantes/{id}/acompanhamento/{id}  versão PÚBLICA do pedido (sem dados pessoais): o cliente lê por "get"
//   restaurantes/{id}/resumos/{AAAA-MM-DD} resumo diário somado pelo servidor (dashboard); o restaurante só lê
//   restaurantes/{id}/dispositivos/{token} aparelhos do restaurante para push (o servidor lê; o painel grava)
//   restaurantes/{id}/contadores/...       número sequencial dos pedidos (só o servidor; negado aqui)
//   usuarios/{uid}/restaurantes/{id}       índice privado de vínculos (escrito só pelo Mestre)
//   _limites/...                           controle de abuso do servidor (negado aqui)
//
// Pedido completo: só o restaurante/Mestre lê (get e list). O cliente acompanha pelo documento
// "acompanhamento" (ID aleatório; sem listagem). NINGUÉM grava pedido, acompanhamento nem resumo pelo
// navegador: criar, mudar status e cancelar passam pelas funções /api (conta de serviço).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções ----------
    function signedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return signedIn() && request.auth.uid == 'KZhENlWEtPNO5w2t6pgh8NTE0wW2';
    }

    // Restaurante existe e está ativo (usado na leitura pública do cardápio)
    function restauranteAtivo(restauranteId) {
      return get(/databases/$(database)/documents/restaurantes/$(restauranteId)).data.ativo == true;
    }

    // Membro ativo de um restaurante que também está ativo
    function isMember(restauranteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurantes/$(restauranteId)/membros/$(request.auth.uid))
        && get(/databases/$(database)/documents/restaurantes/$(restauranteId)/membros/$(request.auth.uid)).data.ativo == true
        && restauranteAtivo(restauranteId);
    }

    function canManageRestaurant(restauranteId) {
      return isMaster() || isMember(restauranteId);
    }

    // "HH:MM" de 00:00 a 23:59 (a virada da meia-noite é permitida: abre 18:00, fecha 02:00)
    function validHora(valor) {
      return valor is string && valor.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // ---------- Validações de dados ----------
    function validRestaurantData(data) {
      return data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 80
        && data.taxaEntregaCentavos is int && data.taxaEntregaCentavos >= 0 && data.taxaEntregaCentavos <= 100000
        && validHora(data.horarioAbertura)
        && validHora(data.horarioFechamento)
        && data.aberto is bool;
    }

    function validCategoryFields(data) {
      return data.keys().hasOnly(['nome', 'ativo', 'ordem', 'criadoEm'])
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 45
        && data.ativo is bool
        && data.ordem is int && data.ordem >= 0 && data.ordem <= 9999;
    }

    function validProductFields(restauranteId, data) {
      return data.keys().hasOnly(['nome', 'descricao', 'precoCentavos', 'categoriaId', 'disponivel', 'ativo', 'criadoEm', 'atualizadoEm'])
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 80
        && data.descricao is string && data.descricao.size() <= 240
        && data.precoCentavos is int && data.precoCentavos > 0 && data.precoCentavos <= 1000000
        && data.categoriaId is string && data.categoriaId.matches('^[A-Za-z0-9]{1,64}$')
        && exists(/databases/$(database)/documents/restaurantes/$(restauranteId)/categorias/$(data.categoriaId))
        && data.disponivel is bool
        && data.ativo is bool
        && data.atualizadoEm == request.time;
    }

    // Ingrediente: custo em "micro" (1 real = 1.000.000). precoMicro é por 1 unidade escolhida; custoMicroPorBase por g, ml ou un.
    function validIngredienteFields(data) {
      return data.keys().hasOnly(['nome', 'unidade', 'precoMicro', 'base', 'custoMicroPorBase', 'ativo', 'criadoEm', 'atualizadoEm'])
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 60
        && data.unidade in ['g', 'kg', 'ml', 'l', 'un']
        && data.base in ['g', 'ml', 'un']
        && data.precoMicro is int && data.precoMicro >= 0 && data.precoMicro <= 100000000000
        && data.custoMicroPorBase is int && data.custoMicroPorBase >= 0 && data.custoMicroPorBase <= 100000000000
        && data.ativo is bool
        && data.atualizadoEm == request.time;
    }

    // Receita do produto (o id do documento é o id do produto). custoMicro = custo de 1 unidade vendida.
    function validReceitaFields(restauranteId, produtoId, data) {
      return data.keys().hasOnly(['itens', 'custoExtraMicro', 'custoMicro', 'atualizadoEm'])
        && data.itens is list && data.itens.size() <= 40
        && data.custoExtraMicro is int && data.custoExtraMicro >= 0 && data.custoExtraMicro <= 10000000000
        && data.custoMicro is int && data.custoMicro >= 0 && data.custoMicro <= 1000000000000
        && exists(/databases/$(database)/documents/restaurantes/$(restauranteId)/produtos/$(produtoId))
        && data.atualizadoEm == request.time;
    }

    // Cupom: o id do documento é o código (letras maiúsculas e números, 3 a 20).
    // percentual: valor de 1 a 100 | fixo: valor em centavos | frete_gratis: valor 0.
    // validadeAte e limiteUsos podem ser null (sem prazo / sem limite). "usos" é do servidor.
    function validCupomFields(cupomId, data) {
      return data.keys().hasOnly(['codigo', 'tipo', 'valor', 'minimoCentavos', 'validadeAte', 'limiteUsos', 'usos', 'ativo', 'criadoEm', 'atualizadoEm'])
        && cupomId.matches('^[A-Z0-9]{3,20}$')
        && data.codigo == cupomId
        && data.tipo in ['percentual', 'fixo', 'frete_gratis']
        && data.valor is int
        && ((data.tipo == 'percentual' && data.valor >= 1 && data.valor <= 100)
          || (data.tipo == 'fixo' && data.valor >= 1 && data.valor <= 1000000)
          || (data.tipo == 'frete_gratis' && data.valor == 0))
        && data.minimoCentavos is int && data.minimoCentavos >= 0 && data.minimoCentavos <= 1000000
        && (data.validadeAte == null || data.validadeAte is timestamp)
        && (data.limiteUsos == null || (data.limiteUsos is int && data.limiteUsos >= 1 && data.limiteUsos <= 100000))
        && data.usos is int && data.usos >= 0
        && data.ativo is bool
        && data.atualizadoEm == request.time;
    }

    // ---------- Restaurantes ----------
    match /restaurantes/{restauranteId} {
      // Público lê só restaurante ativo; Mestre e membros leem sempre (o Mestre vê os desativados)
      allow read: if resource.data.ativo == true || isMaster() || isMember(restauranteId);
      allow create: if isMaster();
      // Dono só altera os campos de configuração, validados; o Mestre altera tudo (inclusive "ativo")
      allow update: if isMaster()
        || (isMember(restauranteId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nome', 'taxaEntregaCentavos', 'horarioAbertura', 'horarioFechamento', 'aberto', 'atualizadoEm'])
          && validRestaurantData(request.resource.data)
          && request.resource.data.atualizadoEm == request.time);
      // Restaurante nunca é apagado pelo app: desative em vez de excluir (apagar só pelo Console)
      allow delete: if false;

      match /membros/{uid} {
        allow read: if isMaster() || (signedIn() && request.auth.uid == uid);
        allow create, update, delete: if isMaster();
      }

      match /categorias/{categoriaId} {
        // Público: só categoria ativa de restaurante ativo. Painel: tudo (inclusive categorias inativas).
        allow read: if (resource.data.ativo == true && restauranteAtivo(restauranteId))
          || canManageRestaurant(restauranteId);
        allow create: if canManageRestaurant(restauranteId)
          && validCategoryFields(request.resource.data)
          && request.resource.data.criadoEm == request.time;
        allow update: if canManageRestaurant(restauranteId)
          && validCategoryFields(request.resource.data)
          && request.resource.data.criadoEm == resource.data.criadoEm;
        allow delete: if canManageRestaurant(restauranteId);
      }

      match /produtos/{produtoId} {
        // Público: só produto ativo (não arquivado) de restaurante ativo. Painel: tudo (inclusive arquivados).
        allow read: if (resource.data.ativo == true && restauranteAtivo(restauranteId))
          || canManageRestaurant(restauranteId);
        allow create: if canManageRestaurant(restauranteId)
          && validProductFields(restauranteId, request.resource.data)
          && request.resource.data.criadoEm == request.time;
        allow update: if canManageRestaurant(restauranteId)
          && validProductFields(restauranteId, request.resource.data)
          && request.resource.data.criadoEm == resource.data.criadoEm;
        // Produto não é apagado pelo painel (fica "arquivado": ativo = false), para o histórico de pedidos
        allow delete: if isMaster();
      }

      match /ingredientes/{ingredienteId} {
        // Custos são PRIVADOS: só o restaurante (e o Mestre) lê ou grava. O cliente nunca vê.
        allow read: if canManageRestaurant(restauranteId);
        allow create: if canManageRestaurant(restauranteId)
          && validIngredienteFields(request.resource.data)
          && request.resource.data.criadoEm == request.time;
        allow update: if canManageRestaurant(restauranteId)
          && validIngredienteFields(request.resource.data)
          && request.resource.data.criadoEm == resource.data.criadoEm;
        allow delete: if canManageRestaurant(restauranteId);
      }

      match /receitas/{produtoId} {
        // Receita e custo por produto: privado. O servidor copia o custo para o pedido na hora da venda.
        allow read: if canManageRestaurant(restauranteId);
        allow create, update: if canManageRestaurant(restauranteId)
          && validReceitaFields(restauranteId, produtoId, request.resource.data);
        allow delete: if canManageRestaurant(restauranteId);
      }

      match /cupons/{cupomId} {
        // Cupons são PRIVADOS: o cliente nunca lista nem lê (assim ninguém descobre os códigos).
        // Ele confere o código por /api/validar-cupom e o pedido valida de novo no servidor.
        allow read: if canManageRestaurant(restauranteId);
        // Novo cupom sempre começa com 0 usos
        allow create: if canManageRestaurant(restauranteId)
          && validCupomFields(cupomId, request.resource.data)
          && request.resource.data.usos == 0
          && request.resource.data.criadoEm == request.time;
        // O restaurante edita regras do cupom, mas NÃO mexe nos usos (só o servidor soma e devolve)
        allow update: if canManageRestaurant(restauranteId)
          && validCupomFields(cupomId, request.resource.data)
          && request.resource.data.usos == resource.data.usos
          && request.resource.data.criadoEm == resource.data.criadoEm;
        allow delete: if canManageRestaurant(restauranteId);
      }

      match /pedidos/{pedidoId} {
        // Pedido completo tem nome, telefone e endereço: só o restaurante (e o Mestre) lê, um a um ou em lista.
        // O cliente NÃO lê aqui: ele usa o documento "acompanhamento".
        allow get, list: if canManageRestaurant(restauranteId);
        // O navegador NUNCA grava pedido: criar é /api/criar-pedido, mudar status é /api/atualizar-status
        // (e cancelar pelo cliente é /api/cancelar-pedido). O servidor usa conta de serviço e ignora estas regras.
        allow create, update, delete: if false;
      }

      match /acompanhamento/{pedidoId} {
        // Versão pública do pedido, SEM dados pessoais. Quem tem o ID aleatório lê só aquele documento.
        allow get: if true;
        allow list: if false;
        // Só o servidor grava (criar-pedido, atualizar-status e cancelar-pedido)
        allow create, update, delete: if false;
      }

      match /resumos/{dia} {
        // Resumo diário (contadores já somados pelo servidor): o restaurante lê para o dashboard
        allow read: if canManageRestaurant(restauranteId);
        allow create, update, delete: if false;
      }

      match /dispositivos/{token} {
        // Aparelhos que recebem push. Só o servidor lê (para enviar o aviso); o painel cadastra e remove.
        allow read: if false;
        allow create, update: if canManageRestaurant(restauranteId)
          && request.resource.data.keys().hasOnly(['token', 'uid', 'atualizadoEm'])
          && request.resource.data.token == token
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.atualizadoEm == request.time;
        allow delete: if canManageRestaurant(restauranteId);
      }
    }

    // ---------- Índice de vínculos do usuário ----------
    match /usuarios/{uid}/restaurantes/{restauranteId} {
      allow read: if isMaster() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isMaster();
    }

    // ---------- Diagnóstico (teste de escrita do Mestre) ----------
    match /_diagnostico/{id} {
      allow read, write: if isMaster();
    }

    // ---------- Todo o resto negado (inclui contadores e _limites, usados só pelo servidor) ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
